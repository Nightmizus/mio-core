MIO_ENV=development
MIO_HOST=127.0.0.1
MIO_PORT=8787
MIO_PUBLIC_URL=http://127.0.0.1:8787
MIO_DATA_DIR=C:\MioCore\data
MIO_WORKSPACES_DIR=C:\MioCore\workspaces
MIO_DATABASE_URL=sqlite:///C:/MioCore/data/mio.db
MIO_SESSION_SECRET=replace-with-at-least-32-random-characters
MIO_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token
MIO_LLM_API_KEY=
MIO_LLM_BASE_URL=https://api.deepseek.com
MIO_LLM_MODEL=deepseek-v4-flash
MIO_MUSIC_REMOTE=git@github.com:shizwd/musicmizu.git
MIO_MUSIC_BRANCH=main
MIO_GIT_SSH_COMMAND=ssh -i C:\MioCore\data\keys\musicmizu -o IdentitiesOnly=yes
MIO_FAIRCAMP_PATH=C:\MioCore\app\tools\faircamp.exe
MIO_FFMPEG_PATH=ffmpeg.exe
MIO_FFPROBE_PATH=ffprobe.exe
MIO_POWERSHELL_PATH=powershell.exe
MIO_SECURE_COOKIES=false
MIO_ENABLE_DEFENDER_SCAN=true
